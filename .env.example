OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=alloy
AI_NAME=ChatGPT
AI_OWNER=
DEFAULT_SERVER=local-survival
MC_USERNAME=
MC_AUTH=microsoft
AUTONOMOUS_ENABLED=true
AUTONOMOUS_THINK_INTERVAL_MS=5000
MEMORY_ENABLED=true
VOICE_ENABLED=true
# browser = local microphone/speakers; minecraft = Simple Voice Chat
VOICE_MODE=browser
BROWSER_VOICE_PORT=3001
# Fabric launcher selects the fabric-client profile. Pairing token is generated locally.
FABRIC_BRIDGE_PORT=8765
VOICE_TEXT_FALLBACK=true
REFLEXES_ENABLED=true
LOG_LEVEL=info
TEST_MODE=false
DATA_DIR=./data
LOG_DIR=./logs
SERVERS_DIR=./servers
ENTITY_SCAN_RADIUS=32
BLOCK_SCAN_RADIUS=24
PLAYER_SCAN_RADIUS=64
ACTION_TIMEOUT_MS=30000
MAX_TOOL_ROUNDS=6
# Fabric only: no automatic task/action deadlines or conservative terrain checks.
# Requires the updated mod and interrupt-enabled browser panel. Ongoing API charges are possible.
FABRIC_UNRESTRICTED=false
RECONNECT_MAX_ATTEMPTS=5
RECONNECT_BASE_DELAY_MS=2000
EXPERIMENT_MODE=
